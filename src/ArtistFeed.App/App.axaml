<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArtistFeed.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Dark, the default colour scheme. Services/Display.cs swaps these for Light or High contrast (Settings → Display). -->
      <SolidColorBrush x:Key="Bg" Color="#0f1012" />
      <SolidColorBrush x:Key="Panel" Color="#17191d" />
      <SolidColorBrush x:Key="Panel2" Color="#1f2227" />
      <SolidColorBrush x:Key="Line" Color="#2a2e35" />
      <SolidColorBrush x:Key="Text" Color="#eceef1" />
      <SolidColorBrush x:Key="Muted" Color="#8d95a1" />
      <SolidColorBrush x:Key="Accent" Color="#d9f25c" />
      <SolidColorBrush x:Key="AccentInk" Color="#d9f25c" />
      <SolidColorBrush x:Key="Danger" Color="#ff6b6b" />
      <SolidColorBrush x:Key="OnAccent" Color="#14160a" />
      <SolidColorBrush x:Key="Hover" Color="#444a55" />
      <SolidColorBrush x:Key="Letter" Color="#3a3f48" />
      <SolidColorBrush x:Key="Overlay" Color="#cc0f1012" />
      <SolidColorBrush x:Key="PlayingRow" Color="#262b1a" />
      <!-- Fluent's own accent follows the app's -->
      <Color x:Key="SystemAccentColor">#d9f25c</Color>
      <Color x:Key="SystemAccentColorDark1">#c4dc4f</Color>
      <Color x:Key="SystemAccentColorDark2">#aec444</Color>
      <Color x:Key="SystemAccentColorLight1">#e2f57f</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://ArtistFeed/Styles.axaml" />
  </Application.Styles>
</Application>
