<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArtistFeed.App.ViewModels"
        x:Class="ArtistFeed.App.Views.TrackedArtistsWindow"
        x:DataType="vm:TrackedArtistsViewModel"
        x:Name="Root"
        Title="Tracked Artists — Artist Feed"
        Width="1240" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h2" Text="Tracked Artists" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Unsaved changes" Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center" IsVisible="{Binding Dirty}" />
          <Button Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding Dirty}" />
          <Button Content="Save changes" Classes="primary" Classes.clean="{Binding !Dirty}" Command="{Binding SaveCommand}" IsEnabled="{Binding !Saving}" />
          <Button Content="Close" Click="CloseClicked" />
        </StackPanel>
      </Grid>
      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="8">
        <StackPanel Spacing="4">
          <TextBlock Classes="tlabel" Text="Add artists" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding AddRowCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M12 5l0 14 M5 12l14 0" /></Canvas></Viewbox><TextBlock Text="Add row" /></StackPanel></Button>
            <Button Command="{Binding ImportCsvCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z M12 11v6 M9.5 13.5l2.5 -2.5l2.5 2.5" /></Canvas></Viewbox><TextBlock Text="Import CSV" /></StackPanel></Button>
            <ToggleButton Classes="panel" IsChecked="{Binding ShowFollows, Mode=OneWay}" Command="{Binding ToggleFollowsCommand}"
                          ToolTip.Tip="Add the artists and labels a SoundCloud account or Bandcamp fan follows"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0 M16 19h6 M19 16v6 M6 21v-2a4 4 0 0 1 4 -4h4" /></Canvas></Viewbox><TextBlock Text="Import follows" /><Viewbox Width="16" Height="16" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M6 9l6 6l6 -6" /></Canvas></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding $parent[ToggleButton].IsChecked}"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M6 15l6 -6l6 6" /></Canvas></Viewbox></StackPanel></ToggleButton>
          </StackPanel>
        </StackPanel>
        <Border Width="1" Background="{DynamicResource Line}" Margin="8,0" />
        <StackPanel Spacing="4">
          <TextBlock Classes="tlabel" Text="Organize" />
          <ToggleButton Classes="panel" IsChecked="{Binding ShowSpaces, Mode=OneWay}" Command="{Binding ToggleSpacesCommand}"
                        ToolTip.Tip="Name the groups of artists you can show on their own (Focus is the first)"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M9 4h3l2 2h5a2 2 0 0 1 2 2v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2 M17 17v2a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-9a2 2 0 0 1 2 -2h2" /></Canvas></Viewbox><TextBlock Text="Workspaces" /><Viewbox Width="16" Height="16" IsVisible="{Binding !$parent[ToggleButton].IsChecked}"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M6 9l6 6l6 -6" /></Canvas></Viewbox><Viewbox Width="16" Height="16" IsVisible="{Binding $parent[ToggleButton].IsChecked}"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M6 15l6 -6l6 6" /></Canvas></Viewbox></StackPanel></ToggleButton>
        </StackPanel>
        <Border Width="1" Background="{DynamicResource Line}" Margin="8,0" />
        <StackPanel Spacing="4">
          <TextBlock Classes="tlabel" Text="Table" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ExportCsvCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M14 3v4a1 1 0 0 0 1 1h4 M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z M12 17v-6 M9.5 14.5l2.5 2.5l2.5 -2.5" /></Canvas></Viewbox><TextBlock Text="Export CSV" /></StackPanel></Button>
            <Button x:Name="ClearButton" Classes="danger" Command="{Binding ClearAllCommand}" ToolTip.Tip="{Binding ClearTip}"><StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Data="M4 7l16 0 M10 11l0 6 M14 11l0 6 M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12 M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></Canvas></Viewbox><TextBlock Text="{Binding ClearLabel}" /></StackPanel></Button>
          </StackPanel>
        </StackPanel>
      </WrapPanel>
      <Border Classes="subpanel" IsVisible="{Binding ShowFollows}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding FollowSites}" SelectedItem="{Binding FollowSite}" ToolTip.Tip="Site to read follows from" />
            <TextBox Text="{Binding FollowUser}" PlaceholderText="Username" Width="220" />
            <Button Content="Read follows" Command="{Binding ReadFollowsCommand}" IsEnabled="{Binding !Reading}" />
            <TextBlock Classes="muted" Text="{Binding FollowStatus}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                     Text="The profiles a SoundCloud account follows, or the artists and labels a Bandcamp fan follows (the fan page must be public). Pick the ones to add: each becomes a row, or joins the row that already has that name. Nothing is tracked until you Save changes. YouTube keeps subscriptions private, so it can't be read." />
          <StackPanel Spacing="8" IsVisible="{Binding HasFollows}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox Content="Select all" IsChecked="{Binding FollowAll}" />
              <TextBlock Classes="muted" Text="{Binding FollowCount}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="Also put them in" VerticalAlignment="Center" Margin="12,0,0,0" />
              <ComboBox ItemsSource="{Binding SpaceChoices}" SelectedItem="{Binding FollowSpace}" />
              <Button Content="Add to table" Classes="primary" Command="{Binding AddFollowsCommand}" />
            </StackPanel>
            <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding FollowItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FollowItem">
                    <CheckBox IsChecked="{Binding Pick}" IsEnabled="{Binding Open}" Width="260" ToolTip.Tip="{Binding Followed.Url}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="140" FontSize="13" />
                        <TextBlock Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxWidth="90" FontSize="11.5" VerticalAlignment="Center" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="subpanel" IsVisible="{Binding ShowSpaces}">
        <StackPanel Spacing="6">
          <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                     Text="A workspace is a group of artists with its own name, such as Focus, Labels or Deep dubstep. Tick the artists in each in the Workspaces column. Choose a workspace at the top of the main window to show only its artists. An artist can be in several. Changes are kept when you Save changes." />
          <ItemsControl ItemsSource="{Binding Spaces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkspaceDraft">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                  <TextBox Text="{Binding Name}" Width="240" />
                  <Button Classes="small" Content="↑" ToolTip.Tip="Move up" Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).MoveSpaceUpCommand}" CommandParameter="{Binding}" />
                  <Button Classes="small" Content="↓" ToolTip.Tip="Move down" Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).MoveSpaceDownCommand}" CommandParameter="{Binding}" />
                  <Button Classes="small ghost" Content="✕" ToolTip.Tip="Remove this workspace (its artists stay tracked)"
                          Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).RemoveSpaceCommand}" CommandParameter="{Binding}" />
                  <TextBlock Classes="muted" Text="{Binding CountText}" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Add workspace" Command="{Binding AddSpaceCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10">
        <StackPanel Spacing="8">
          <WrapPanel ItemSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="6"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="ico" Stroke="{DynamicResource Text}" Data="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6" /></Canvas></Viewbox><TextBlock Text="Find missing links" FontWeight="SemiBold" /></StackPanel>
            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Fills empty Bandcamp, SoundCloud and name cells with its best guess, highlighted: check them, then Save changes." />
          </WrapPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="find" Content="{Binding FillLabel}" Command="{Binding FindMissingCommand}"
                    ToolTip.Tip="Look for the Bandcamp pages and SoundCloud profiles rows are missing. While the table is filtered, only the rows shown are searched; each row also has its own Find links." />
            <StackPanel Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="Look on" VerticalAlignment="Center" />
                <ListBox Classes="segpick" ItemsSource="{Binding FillSiteOptions}" SelectedItem="{Binding FillSite}" IsEnabled="{Binding !Filling}"
                         ToolTip.Tip="Which links Find missing links looks for. A missing name is filled in either way.">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate><DataTemplate x:DataType="vm:Option"><TextBlock Text="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <CheckBox Content="Only rows not searched yet" IsChecked="{Binding SkipSearched}" IsEnabled="{Binding !Filling}" VerticalAlignment="Center"
                        ToolTip.Tip="Search a row only for the sites it hasn't been searched for before. Untick to search every row again, or tick Rescan on one row." />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{Binding FillStatus}" Classes="muted" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding FillStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="tlabel" Text="Show" VerticalAlignment="Center" />
        <TextBox Text="{Binding FilterText}" PlaceholderText="Filter rows" Width="200" ToolTip.Tip="Show only rows containing these words" />
        <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" ToolTip.Tip="Which rows to show" />
      </StackPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                 Text="One row per artist. Type in the cells, or import or paste a list. Leave a cell empty if the artist isn't on that site; separate several pages in one cell with commas. The Artist cell can hold other names the artist goes by, after commas: the first is shown in the feed (put a name that contains a comma in &quot;double quotes&quot;). Find missing links fills empty Bandcamp, SoundCloud and name cells with its best guess, highlighted: check them, then Save changes. While the table is filtered, Find missing links and Clear work on the rows shown only. A cell you clear stays empty on later runs unless you tick that row's Rescan box. Changes take effect when you press Save changes. Click a heading (Artist, a site, Status) to sort by it; again to reverse; a third time to go back to name order." />
      <WrapPanel Orientation="Horizontal" ItemSpacing="12">   <!-- a long message wraps instead of running off the edge -->
        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AccentInk}" TextWrapping="Wrap" />
        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" />
      </WrapPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12" Background="{DynamicResource Panel}" CornerRadius="10" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Paste a list to add: one artist or label per line. A name, a Bandcamp, SoundCloud or YouTube link, or name and links separated by tabs or commas." />
        <Button DockPanel.Dock="Right" Content="Add to table" Command="{Binding AddPastedCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
        <TextBox Text="{Binding PasteText}" AcceptsReturn="True" Height="70" TextWrapping="NoWrap"
                 PlaceholderText="Night Ferry&#10;https://somelabel.bandcamp.com&#10;Another Artist, anotherartist, another-artist" />
      </DockPanel>
    </Border>

    <DataGrid x:Name="Table" ItemsSource="{Binding Visible}" Margin="0,10,0,0" CanUserSortColumns="True" CanUserReorderColumns="False" Sorting="TableSorting"
              CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" RowHeight="NaN">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <Button Classes="small ghost" Content="{Binding RemoveGlyph}" ToolTip.Tip="{Binding RemoveTip}" VerticalAlignment="Top" Margin="0,6,0,0"
                      Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).ToggleRemoveCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Artist" Width="2*" MinWidth="160" Tag="name" SortMemberPath="name" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <StackPanel Margin="2,4" Spacing="2">
                <TextBox Text="{Binding Name}" PlaceholderText="Name (from the page if left empty)" Classes.removed="{Binding Remove}" Classes.auto="{Binding AutoName}" />
                <CheckBox Content="Keep both: different artists" IsChecked="{Binding KeepSeparate}" IsVisible="{Binding SameName}" FontSize="12"
                          ToolTip.Tip="Two rows share this name. Tick if they really are different artists; otherwise merge them into one row." />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Bandcamp" Width="2*" MinWidth="140" Tag="bandcamp" SortMemberPath="bandcamp" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding Bandcamp}" Margin="2,4" VerticalAlignment="Top" PlaceholderText="artistname" Classes.auto="{Binding AutoBandcamp}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="SoundCloud" Width="2*" MinWidth="140" Tag="soundcloud" SortMemberPath="soundcloud" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding SoundCloud}" Margin="2,4" VerticalAlignment="Top" PlaceholderText="username" Classes.auto="{Binding AutoSoundCloud}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="YouTube" Width="2*" MinWidth="140" Tag="youtube" SortMemberPath="youtube" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding YouTube}" Margin="2,4" VerticalAlignment="Top" PlaceholderText="@handle" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Workspaces" Width="1.4*" CanUserSort="False" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <ItemsControl ItemsSource="{Binding Ticks}" Margin="4,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupTick">
                    <CheckBox IsChecked="{Binding IsIn}" Content="{Binding Space.Name}" FontSize="12"
                              ToolTip.Tip="In this workspace: choose it at the top of the main window to show only its artists" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="YouTube search" Width="142" CanUserSort="False" Tag="youtube_lookup">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <CheckBox IsChecked="{Binding YoutubeLookup}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                        ToolTip.Tip="Link Finder may look for this artist's tracks on YouTube (when YouTube is ticked for Link Finder in Settings)" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Rescan" Width="92" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <CheckBox IsChecked="{Binding Rescan}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                        ToolTip.Tip="Search this row's empty cells again, including ones you cleared. Earlier guesses you removed are not offered again." />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Status" Width="2*" MinWidth="150" Tag="state" SortMemberPath="state" CanUserSort="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <StackPanel Margin="6,8,6,6" Spacing="2" ToolTip.Tip="{Binding StatusText}">
                <TextBlock Classes="muted small" Text="{Binding StatusShort}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="error small" Text="{Binding Errors}" TextWrapping="Wrap" IsVisible="{Binding HasErrors}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="96" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <StackPanel Spacing="4" Margin="0,6,0,0">
              <Button Classes="small" Content="Find links" IsVisible="{Binding HasOpen}"
                      IsEnabled="{Binding !#Root.((vm:TrackedArtistsViewModel)DataContext).Filling}"
                      Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).FindRowCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Look for this row's missing Bandcamp page or SoundCloud profile (only this row)" />
              <Button Classes="small" Content="Check now"
                      IsVisible="{Binding !IsNew}" IsEnabled="{Binding !Checking}"
                      Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).CheckNowCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Read this artist's pages now, without waiting for the next refresh" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
