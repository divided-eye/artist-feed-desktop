<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArtistFeed.App.ViewModels"
        x:Class="ArtistFeed.App.Views.TrackedArtistsWindow"
        x:DataType="vm:TrackedArtistsViewModel"
        x:Name="Root"
        Title="Tracked Artists — Artist Feed"
        Width="1240" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="h2" Text="Tracked Artists" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Unsaved changes" Foreground="{StaticResource Accent}" VerticalAlignment="Center" IsVisible="{Binding Dirty}" />
          <Button Content="Discard" Command="{Binding DiscardCommand}" IsVisible="{Binding Dirty}" />
          <Button Content="Save changes" Classes="primary" Classes.clean="{Binding !Dirty}" Command="{Binding SaveCommand}" IsEnabled="{Binding !Saving}" />
          <Button Content="Close" Click="CloseClicked" />
        </StackPanel>
      </Grid>
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <Button Content="Add row" Command="{Binding AddRowCommand}" />
        <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" />
        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
        <Button Content="Clear All" Command="{Binding ClearAllCommand}" ToolTip.Tip="Empty the whole table (nothing is removed until you save)" />
        <TextBox Text="{Binding FilterText}" Watermark="Filter rows" Width="200" ToolTip.Tip="Show only rows containing these words" />
        <ComboBox ItemsSource="{Binding ShowOptions}" SelectedItem="{Binding Show}" ToolTip.Tip="Which rows to show" />
      </WrapPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                 Text="One row per artist. Type in the cells, or import or paste a list. Leave a cell empty if the artist isn't on that site; separate several pages in one cell with commas. The Artist cell can hold other names the artist goes by, after commas: the first is shown in the feed (put a name that contains a comma in &quot;double quotes&quot;). Changes take effect when you press Save changes." />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
        <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="12" Background="{StaticResource Panel}" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Paste a list to add: one artist or label per line. A name, a Bandcamp, SoundCloud or YouTube link, or name and links separated by tabs or commas." />
        <Button DockPanel.Dock="Right" Content="Add to table" Command="{Binding AddPastedCommand}" VerticalAlignment="Top" Margin="8,0,0,0" />
        <TextBox Text="{Binding PasteText}" AcceptsReturn="True" Height="70" TextWrapping="NoWrap"
                 Watermark="Night Ferry&#10;https://somelabel.bandcamp.com&#10;Another Artist, anotherartist, another-artist" />
      </DockPanel>
    </Border>

    <DataGrid x:Name="Table" ItemsSource="{Binding Visible}" Margin="0,10,0,0" CanUserSortColumns="False" CanUserReorderColumns="False"
              CanUserResizeColumns="True" HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" RowHeight="NaN">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <Button Classes="small ghost" Content="{Binding RemoveGlyph}" ToolTip.Tip="{Binding RemoveTip}" VerticalAlignment="Top" Margin="0,6,0,0"
                      Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).ToggleRemoveCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Artist" Width="2*" MinWidth="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <StackPanel Margin="2,4" Spacing="2">
                <TextBox Text="{Binding Name}" Watermark="Name (from the page if left empty)" Classes.removed="{Binding Remove}" />
                <CheckBox Content="Keep both: different artists" IsChecked="{Binding KeepSeparate}" IsVisible="{Binding SameName}" FontSize="12"
                          ToolTip.Tip="Two rows share this name. Tick if they really are different artists; otherwise merge them into one row." />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Bandcamp" Width="2*" MinWidth="140" Tag="bandcamp">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding Bandcamp}" Margin="2,4" VerticalAlignment="Top" Watermark="artistname" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="SoundCloud" Width="2*" MinWidth="140" Tag="soundcloud">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding SoundCloud}" Margin="2,4" VerticalAlignment="Top" Watermark="username" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="YouTube" Width="2*" MinWidth="140" Tag="youtube">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <TextBox Text="{Binding YouTube}" Margin="2,4" VerticalAlignment="Top" Watermark="@handle" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Focus" Width="86">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <CheckBox IsChecked="{Binding Focus}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                        ToolTip.Tip="Show this artist in the Focus Feed" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="YouTube search" Width="142" Tag="youtube_lookup">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <CheckBox IsChecked="{Binding YoutubeLookup}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                        ToolTip.Tip="Link Finder may look for this artist's tracks on YouTube (kept for the web app; Link Finder comes in a later version)" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Status" Width="2*" MinWidth="150">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <StackPanel Margin="6,8,6,6" Spacing="2" ToolTip.Tip="{Binding StatusText}">
                <TextBlock Classes="muted small" Text="{Binding StatusShort}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="error small" Text="{Binding Errors}" TextWrapping="Wrap" IsVisible="{Binding HasErrors}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="96">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ArtistRowViewModel">
              <Button Classes="small" Content="Check now" VerticalAlignment="Top" Margin="0,6,0,0"
                      IsVisible="{Binding !IsNew}" IsEnabled="{Binding !Checking}"
                      Command="{Binding #Root.((vm:TrackedArtistsViewModel)DataContext).CheckNowCommand}" CommandParameter="{Binding}"
                      ToolTip.Tip="Read this artist's pages now, without waiting for the next refresh" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
