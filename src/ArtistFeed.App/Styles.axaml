<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20"><Button Classes="primary" Content="Save" /></Border>
  </Design.PreviewWith>

  <Style Selector="Window">
    <Setter Property="Icon" Value="/Assets/icon.ico" />
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  
  <Style Selector="DataGridCell.dim">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.error, SelectableTextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Buttons: a quiet panel by default; .primary is the accent; .small is compact. -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.primary, ToggleButton:checked">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A Save button with nothing to save looks quiet. -->
  <Style Selector="Button.primary.clean">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Button.primary.clean:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.small, ToggleButton.small">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <!-- the Downloads button while it is switched off or has no Bandcamp username: greyed out, with a tooltip saying why -->
  <Style Selector="Button.off">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <!-- the ⓘ beside the status line -->
  <Style Selector="Button.infobtn">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontFamily" Value="Georgia, Times New Roman, serif" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Help" />
  </Style>
  <Style Selector="Button.infobtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Text}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.infobtn.warn">
    <Setter Property="BorderBrush" Value="{DynamicResource Warn}" />
    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Site buttons at the top: rounded chips. -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Padding" Value="12,5" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="TextBox, ComboBox, CalendarDatePicker">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- a cell filled in by Find missing links: check it, then Save -->
  <Style Selector="TextBox.auto">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="BorderBrush" Value="#7dc8ff" />
    <Setter Property="Background" Value="#297dc8ff" />
  </Style>
  <Style Selector="TextBox.removed">
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="ComboBox.on, CalendarDatePicker.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- Feed cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="Border.card.playing">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.card.hidden">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.card.played > Grid > :is(Control).fade">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.card.played:pointerover > Grid > :is(Control).fade, Border.card.played.playing > Grid > :is(Control).fade">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.card Button.hidebtn">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.card:pointerover Button.hidebtn, Border.card.hidden Button.hidebtn">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.subpanel">
    <Setter Property="Background" Value="{DynamicResource Panel2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="DataGridRow.played">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="DataGridRow.hidden">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="DataGridRow.playing">
    <Setter Property="Background" Value="{DynamicResource PlayingRow}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- High contrast: thicker outlines -->
  <Style Selector="Window.contrast Border.card">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Window.contrast Button, Window.contrast ToggleButton, Window.contrast TextBox, Window.contrast ComboBox">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Window.contrast Button.ghost, Window.contrast Button.link">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Window.contrast Border.card.played > Grid > :is(Control).fade">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Window.contrast Border.card.played:pointerover > Grid > :is(Control).fade, Window.contrast Border.card.played.playing > Grid > :is(Control).fade">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
